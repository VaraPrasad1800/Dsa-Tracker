DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-for-production

# -------------------------------------------------------
# Database (leave all POSTGRES_* empty for SQLite in dev)
# -------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# -------------------------------------------------------
# Redis & Celery (leave empty for in-memory cache in dev)
# -------------------------------------------------------
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_ALWAYS_EAGER=False

# -------------------------------------------------------
# CORS — Production only
# Comma-separated list of allowed frontend origins.
# Leave empty in local development (allows all origins).
# Example: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# -------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# -------------------------------------------------------
# Frontend URL — used in email verification / reset links
# -------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------
# JWT Configuration
# -------------------------------------------------------
JWT_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_HOURS=168

