DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-for-production

# -------------------------------------------------------
# Database Configuration
# Local dev defaults to SQLite (db.sqlite3).
# In local dev (DEBUG=True), SQLite is used unless USE_POSTGRES=True.
# In production (DEBUG=False), PostgreSQL is used if POSTGRES_DB is set.
# -------------------------------------------------------
USE_SQLITE=True
USE_POSTGRES=False
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# -------------------------------------------------------
# Cache & Celery
# Set USE_REDIS=False for in-memory LocMemCache (Windows dev friendly).
# Set CELERY_ALWAYS_EAGER=True to execute tasks synchronously without a broker.
# -------------------------------------------------------
USE_REDIS=False
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_ALWAYS_EAGER=True

# -------------------------------------------------------
# CORS & CSRF
# Comma-separated list of allowed frontend origins.
# Defaults to localhost:5173 and 127.0.0.1:5173 in dev.
# -------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------
# Frontend URL — used in email verification / reset links
# -------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------
# JWT Configuration
# -------------------------------------------------------
JWT_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_HOURS=168


