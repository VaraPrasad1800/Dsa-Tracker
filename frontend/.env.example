# ============================================================
# DSA Tracker — Frontend Environment Variables
# ============================================================
#
# VITE_ variables are baked into the JavaScript bundle at BUILD
# TIME. They are NOT available at runtime and cannot be changed
# without a new deployment.
#
# HOW TO USE FOR LOCAL DEVELOPMENT:
#   Copy this file to .env.local:
#   VITE_API_URL=http://localhost:8001
#   VITE_BACKEND_PORT=8001
#   VITE_API_BASE_URL=http://localhost:8001/api
#   The Vite dev proxy automatically proxies /api to http://127.0.0.1:8001.
#
# HOW TO USE FOR PRODUCTION:
#   Set VITE_API_URL to your backend API URL, e.g.:
#   VITE_API_URL=https://your-backend-domain.com
#   VITE_API_BASE_URL=https://your-backend-domain.com/api
# ============================================================

# Backend API URL for local dev (http://localhost:8001)
VITE_API_URL=http://localhost:8001
VITE_API_BASE_URL=http://localhost:8001/api

# Port where Django is running locally (default: 8001)
VITE_BACKEND_PORT=8001

