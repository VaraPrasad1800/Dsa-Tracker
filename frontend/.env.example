# ============================================================
# DSA Tracker — Frontend Environment Variables
# ============================================================
#
# VITE_ variables are baked into the JavaScript bundle at BUILD
# TIME. They are NOT available at runtime and cannot be changed
# without a new deployment.
#
# HOW TO USE FOR PRODUCTION (Vercel):
#   1. Vercel dashboard → Project → Settings → Environment Variables
#   2. Add VITE_API_BASE_URL = https://your-render-service.onrender.com/api
#   3. Redeploy (required — Vite inlines this value at build time)
#
# HOW TO USE FOR LOCAL DEVELOPMENT:
#   Copy this file to .env.local and set values.
#   In local dev you can leave VITE_API_BASE_URL empty; the Vite proxy
#   in vite.config.js handles /api → http://127.0.0.1:8001 automatically.
# ============================================================

# Base URL of the Django backend API. Must include the /api prefix.
# No trailing slash.
#
# Production example:
#   VITE_API_BASE_URL=https://dsa-tracker-backend.onrender.com/api
#
# If this is unset in Vercel, client.js falls back to '/api', which
# resolves to the Vercel domain itself and returns 404 for all API calls.
VITE_API_BASE_URL=https://your-render-service.onrender.com/api
